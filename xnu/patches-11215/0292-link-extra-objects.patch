link: let the build append objects made outside the tree

tools/mk-ath10k.py (Stage B) builds the Wi-Fi driver into one object outside
xnu, because it needs Linux 7.0.14, FreeBSD 15.1 and the SDK's cctools, and
nothing of that belongs in this tree. KERNEL_EXTRA_OBJECTS names such objects
and the link puts them at the end of the kernel's non-LTO list; a name that is
not there is a fatal error rather than a silently smaller kernel.

Empty by default, so builds without the object are unchanged.

diff --git a/makedefs/MakeInc.kernel b/makedefs/MakeInc.kernel
index 3939409..dc38ddc 100644
--- a/makedefs/MakeInc.kernel
+++ b/makedefs/MakeInc.kernel
@@ -213,11 +213,17 @@ ifeq ($(PRE_LTO),1)
 						nonlto="$$(printf '%s\n%s' "$$nonlto" "$$ofile")"; \
 				fi; \
 			fi; \
 	done; \
 	printf '%s\n' "$$lto" >ltolink.filelist; \
-	printf '%s\n' "$$nonlto" >nonltolink.filelist
+	printf '%s\n' "$$nonlto" >nonltolink.filelist; \
+	if [ -n "$(KERNEL_EXTRA_OBJECTS)" ]; then \
+		for o in $(KERNEL_EXTRA_OBJECTS); do \
+			test -f "$$o" || { echo "KERNEL_EXTRA_OBJECTS: $$o is missing" >&2; exit 1; }; \
+			printf '%s\n' "$$o" >> nonltolink.filelist; \
+		done; \
+	fi
 	@$(LOG_LD) "$(@F)"
 	$(_v)if [ -s ltolink.filelist ]; \
 	then \
 		$(LD) $($(addsuffix $(CURRENT_ARCH_CONFIG),ARCH_FLAGS_)) -r nonlto.o -filelist ltolink.filelist $(LDFLAGS_KERNEL_LTO) -Wl,-object_path_lto,$(TARGET)/justlto.o -o $(TARGET)/justlto.tmp.o && \
 		if test -d $(TARGET)/justlto.o; \
