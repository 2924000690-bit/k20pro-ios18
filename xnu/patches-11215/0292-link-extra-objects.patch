link: put KERNEL_EXTRA_OBJECTS into whichever file list the link uses

dxb builds with BUILD_LTO=0, so PRE_LTO is 0 and the kernel is linked from
link.filelist, not nonltolink.filelist: the ath10k object was never in the
kernel (its code was absent and lx_start stayed undefined). Append the extra
objects in both branches.

diff --git a/makedefs/MakeInc.kernel b/makedefs/MakeInc.kernel
index 3939409..adb17d3 100644
--- a/makedefs/MakeInc.kernel
+++ b/makedefs/MakeInc.kernel
@@ -215,7 +215,13 @@ ifeq ($(PRE_LTO),1)
 			fi; \
 	done; \
 	printf '%s\n' "$$lto" >ltolink.filelist; \
-	printf '%s\n' "$$nonlto" >nonltolink.filelist
+	printf '%s\n' "$$nonlto" >nonltolink.filelist; \
+	if [ -n "$(KERNEL_EXTRA_OBJECTS)" ]; then \
+		for o in $(KERNEL_EXTRA_OBJECTS); do \
+			test -f "$$o" || { echo "KERNEL_EXTRA_OBJECTS: $$o is missing" >&2; exit 1; }; \
+			printf '%s\n' "$$o" >> nonltolink.filelist; \
+		done; \
+	fi
 	@$(LOG_LD) "$(@F)"
 	$(_v)if [ -s ltolink.filelist ]; \
 	then \
@@ -232,6 +238,12 @@ ifeq ($(PRE_LTO),1)
 else
 	@$(LOG_LD) "$(@F)"
 	$(_v)$(CAT) $(filter %.filelist,$+) < /dev/null > link.filelist
+	$(_v)	if [ -n "$(KERNEL_EXTRA_OBJECTS)" ]; then \
+		for o in $(KERNEL_EXTRA_OBJECTS); do \
+			test -f "$$o" || { echo "KERNEL_EXTRA_OBJECTS: $$o is missing" >&2; exit 1; }; \
+			printf '%s\n' "$$o" >> link.filelist; \
+		done; \
+	fi
 	$(_v)$(LD) $(LDFLAGS_KERNEL) $(LDFLAGS_KERNEL_ONLY) -filelist link.filelist $(filter %.o,$+) -o $@ $(LD_KERNEL_LIBS) $(LD_KERNEL_ARCHIVES)
 endif
 
