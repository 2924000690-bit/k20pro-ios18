xnu: let low-DMA clients restart the contiguous-page scan

The ARM64 physical window for this board is above 4 GiB. The low-DMA allocator
uses a max_pnum ceiling, but the generic contiguous allocator remembers its
last scan index; once that index is in high physical pages, a later low-memory
allocation can fail without examining the low part of vm_pages[]. Keep the
scan cursor private to the VM module and expose one small helper to reset it.

The caller still uses kmem_alloc_contig() with KMA_LOMEM and a physical-page
ceiling. No VM queue internals are exposed to bsd/dev.

diff --git a/osfmk/vm/vm_page.h b/osfmk/vm/vm_page.h
--- a/osfmk/vm/vm_page.h
+++ b/osfmk/vm/vm_page.h
@@ -1170,6 +1170,10 @@
 extern ppnum_t          max_valid_low_ppnum;
+
+/* Restart the contiguous page allocator's search at vm_pages[0]. */
+extern void             vm_page_reset_contiguous_cursor(boolean_t lowmem);
+
 /*
  * Prototypes for functions exported by this module.
  */
diff --git a/osfmk/vm/vm_resident.c b/osfmk/vm/vm_resident.c
--- a/osfmk/vm/vm_resident.c
+++ b/osfmk/vm/vm_resident.c
@@ -6293,6 +6293,18 @@
 #define VM_PAGE_FIND_CONTIGUOUS_CAN_STEAL 1
 
 static unsigned int vm_page_find_contiguous_last_idx = 0, vm_page_lomem_find_contiguous_last_idx = 0;
+
+/*
+ * Called with neither VM queue lock held. A caller with a stricter physical
+ * address ceiling may need to search the low end after another allocation
+ * advanced the ordinary or low-memory cursor into the high page range.
+ */
+void
+vm_page_reset_contiguous_cursor(boolean_t lowmem)
+{
+	if (lowmem) {
+		vm_page_lomem_find_contiguous_last_idx = 0;
+	} else {
+		vm_page_find_contiguous_last_idx = 0;
+	}
+}
+
 #if DEBUG
 int vm_page_find_contig_debug = 0;
 #endif
