+
+/* The Android boot image read from a file in the payload volume ("file=PATH"). */
+STATIC VOID  *mBootFileBuffer;
+STATIC UINTN mBootFileSize;
+
+STATIC
+EFI_STATUS
+LinuxLoaderBootImageFromFile (CHAR8 *AsciiPath, VOID **Buffer, UINTN *Size)
+{
+  EFI_STATUS                       Status;
+  EFI_LOADED_IMAGE_PROTOCOL        *Loaded = NULL;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *Fs = NULL;
+  EFI_FILE_PROTOCOL                *Root = NULL;
+  EFI_FILE_PROTOCOL                *File = NULL;
+  EFI_FILE_INFO                    *FileInfo = NULL;
+  UINTN                            InfoSize = 0;
+  UINTN                            ReadSize;
+  CHAR16                           Path[256];
+  UINTN                            Index;
+
+  *Buffer = NULL;
+  *Size = 0;
+  if (gImageHandle == NULL) {
+    return EFI_NOT_FOUND;
+  }
+  Status = gBS->HandleProtocol (gImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Loaded);
+  if (EFI_ERROR (Status) || (Loaded == NULL)) {
+    return Status;
+  }
+  Status = gBS->HandleProtocol (Loaded->DeviceHandle, &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs);
+  if (EFI_ERROR (Status) || (Fs == NULL)) {
+    return Status;
+  }
+  Status = Fs->OpenVolume (Fs, &Root);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+  for (Index = 0; (Index + 1 < ARRAY_SIZE (Path)) && (AsciiPath[Index] != 0); Index++) {
+    Path[Index] = (CHAR16)AsciiPath[Index];
+  }
+  Path[Index] = 0;
+  Status = Root->Open (Root, &File, Path, EFI_FILE_MODE_READ, 0);
+  if (EFI_ERROR (Status)) {
+    Root->Close (Root);
+    return Status;
+  }
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, NULL);
+  if (Status != EFI_BUFFER_TOO_SMALL) {
+    File->Close (File); Root->Close (Root);
+    return Status;
+  }
+  FileInfo = AllocatePool (InfoSize);
+  if (FileInfo == NULL) {
+    File->Close (File); Root->Close (Root);
+    return EFI_OUT_OF_RESOURCES;
+  }
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, FileInfo);
+  if (EFI_ERROR (Status) || (FileInfo->FileSize == 0)) {
+    FreePool (FileInfo); File->Close (File); Root->Close (Root);
+    return EFI_ERROR (Status) ? Status : EFI_END_OF_FILE;
+  }
+  *Buffer = AllocatePages (EFI_SIZE_TO_PAGES ((UINTN)FileInfo->FileSize));
+  if (*Buffer == NULL) {
+    FreePool (FileInfo); File->Close (File); Root->Close (Root);
+    return EFI_OUT_OF_RESOURCES;
+  }
+  ReadSize = (UINTN)FileInfo->FileSize;
+  Status = File->Read (File, &ReadSize, *Buffer);
+  FreePool (FileInfo);
+  File->Close (File);
+  Root->Close (Root);
+  if (EFI_ERROR (Status)) {
+    FreePages (*Buffer, EFI_SIZE_TO_PAGES (ReadSize));
+    *Buffer = NULL;
+    return Status;
+  }
+  *Size = ReadSize;
+  return EFI_SUCCESS;
+}
+
+/* Read "partition=NAME" from the LoadOptions the caller (UniXNU) put on the
+ * image, so the same LinuxLoader can boot an Android image kept in another
+ * partition. NULL keeps the default boot/recovery choice. */
+CHAR8 *
+LinuxLoaderPartitionOverride (VOID)
+{
+  STATIC CHAR8              Name[32];
+  EFI_LOADED_IMAGE_PROTOCOL *Loaded = NULL;
+  CHAR16                    *Args;
+  CHAR16                    *Hit;
+  UINTN                     Index;
+
+  if (gImageHandle == NULL) {
+    return NULL;
+  }
+  if (EFI_ERROR (gBS->HandleProtocol (gImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Loaded)) ||
+      (Loaded == NULL) || (Loaded->LoadOptions == NULL)) {
+    return NULL;
+  }
+  Args = (CHAR16 *)Loaded->LoadOptions;
+  Hit = StrStr (Args, L"file=");
+  if (Hit != NULL) {
+    Hit += StrLen (L"file=");
+    Name[0] = 'f'; Name[1] = 'i'; Name[2] = 'l'; Name[3] = 'e'; Name[4] = ':';
+    for (Index = 0; (Index + 6 < sizeof (Name)) && (Hit[Index] != 0) &&
+                    (Hit[Index] != L' ') && (Hit[Index] != L','); Index++) {
+      Name[Index + 5] = (CHAR8)Hit[Index];
+    }
+    Name[Index + 5] = '\0';
+    return (Index == 0) ? NULL : Name;
+  }
+  Hit = StrStr (Args, L"partition=");
+  if (Hit == NULL) {
+    return NULL;
+  }
+  Hit += StrLen (L"partition=");
+  for (Index = 0; (Index + 1 < sizeof (Name)) && (Hit[Index] != 0) && (Hit[Index] != L' ') && (Hit[Index] != L','); Index++) {
+    Name[Index] = (CHAR8)Hit[Index];
+  }
+  Name[Index] = '\0';
+  return (Index == 0) ? NULL : Name;
+}
+
 #define MAX_APP_STR_LEN 64
 #define MAX_NUM_FS 10
 #define DEFAULT_STACK_CHK_GUARD 0xc0c0c0c0
@@ -305,7 +430,20 @@ LinuxLoaderEntry (IN EFI_HANDLE ImageHandle, IN EFI_SYSTEM_TABLE *SystemTable)
     Info.MultiSlotBoot = MultiSlotBoot;
     Info.BootIntoRecovery = BootIntoRecovery;
     Info.BootReasonAlarm = BootReasonAlarm;
-    Status = LoadImageAndAuth (&Info);
+    {
+      CHAR8 *Source = LinuxLoaderPartitionOverride ();
+      if ((Source != NULL) && !AsciiStrnCmp (Source, "file:", 5)) {
+        Status = LinuxLoaderBootImageFromFile (Source + 5, &mBootFileBuffer, &mBootFileSize);
+        if (Status == EFI_SUCCESS) {
+          Info.NumLoadedImages = 1;
+          Info.Images[0].Name = "boot";
+          Info.Images[0].ImageBuffer = mBootFileBuffer;
+          Info.Images[0].ImageSize = mBootFileSize;
+        }
+      } else {
+        Status = LoadImageAndAuth (&Info);
+      }
+    }
     if (Status != EFI_SUCCESS) {
       DEBUG ((EFI_D_ERROR, "LoadImageAndAuth failed: %r\n", Status));
       goto fastboot;
